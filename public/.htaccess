# Server rules for the WHC (LiteSpeed/Apache) hosting of hamelphoto.com.
# GitHub Pages ignores this file.

Options -Indexes
ErrorDocument 404 /404.html

# One address: https://hamelphoto.com (www and http redirect there).
# Only the site's own hostnames; mail.* and webmail.* are left alone, as is SSL validation.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTP_HOST} ^(www\.)?hamelphoto\.com$ [NC]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://hamelphoto.com%{REQUEST_URI} [R=301,L]

  # /index.html and /en/index.html are copies of / and /en/. THE_REQUEST matches only what the
  # visitor typed, not the server's own internal lookup of index.html, so there is no loop.
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ https://hamelphoto.com/$1 [R=301,L,NC]
</IfModule>

AddType image/avif .avif
AddType image/webp .webp
AddType application/manifest+json .webmanifest
AddCharset utf-8 .txt .xml .webmanifest

<IfModule mod_headers.c>
  # Browsers remember to use https for a year. Not includeSubDomains: mail.* and webmail.* stay as they are.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # The site uses none of these browser features; analytics and ads tags don't need them.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

  # Files in /_astro/ have a content hash in their name, so they never change.
  <FilesMatch "\.[\w-]{8}(_[\w-]+)?\.(avif|webp|jpe?g|png|svg|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Pages are checked on every visit so updates show up right away.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
