---
import { site } from '../data/site';
import { routes, htmlLang, type Lang, type PageKey } from '../i18n/routes';
import { ui } from '../i18n/strings';
import { href } from '../i18n/url';

interface Props {
  lang: Lang;
  page: PageKey;
  h1: string;
}

const { lang, page, h1 } = Astro.props;
const t = ui[lang];
---

<header class="site-header">
  <div class="bar">
    <a class="logo" href={href(routes.home[lang])}>{site.name}</a>
    <h1 class="h1">{h1}</h1>
    <div class="contact">
      <a href={site.phoneHref} aria-label={`${t.callLabel} ${site.phoneDisplay}`}>{site.phoneDisplay}</a>
      <a href={`mailto:${site.email}`} aria-label={`${t.emailLabel} ${site.email}`}>{site.email}</a>
    </div>
    <nav class="lang" aria-label={t.langSwitchLabel}>
      {
        (['fr', 'en'] as const).map((l) =>
          l === lang ? (
            <span aria-current="true">{l.toUpperCase()}</span>
          ) : (
            <a href={href(routes[page][l])} hreflang={htmlLang[l]} lang={l}>{l.toUpperCase()}</a>
          ),
        )
      }
    </nav>
  </div>
</header>
