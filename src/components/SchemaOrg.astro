---
import { getImage } from 'astro:assets';
import { site, sameAs } from '../data/site';
import type { Photo } from '../data/images';
import { routes, htmlLang, type Lang, type PageKey } from '../i18n/routes';
import { pages } from '../i18n/strings';

interface Props {
  lang: Lang;
  page: PageKey;
  ogImage: string;
  photos?: Photo[];
}

const { lang, page, ogImage, photos = [] } = Astro.props;
const abs = (path: string) => new URL(path, site.url).href;
const pageUrl = abs(routes[page][lang]);
const text = pages[page][lang];
const businessId = `${site.url}/#business`;
const founderId = `${site.url}/#founder`;
const copyright = `© ${site.name}`;

const areaServed = site.cities.map((name) => ({ '@type': 'City', name }));

const serviceType: Partial<Record<PageKey, Record<Lang, string>>> = {
  event: { fr: 'Photographie d’événements', en: 'Event photography' },
  headshot: { fr: 'Portraits corporatifs', en: 'Corporate headshots' },
  workplace: { fr: 'Photographie corporative en milieu de travail', en: 'Workplace photography' },
};

const graph: Record<string, unknown>[] = [
  {
    '@type': 'ProfessionalService',
    '@id': businessId,
    name: site.name,
    url: `${site.url}/`,
    logo: abs('/icon-512.png'),
    image: ogImage,
    telephone: site.phone,
    email: site.email,
    foundingDate: String(site.foundingYear),
    founder: { '@id': founderId },
    areaServed,
    priceRange: '$$',
    knowsLanguage: ['fr-CA', 'en-CA'],
    ...(sameAs.length && { sameAs }),
  },
  {
    '@type': 'Person',
    '@id': founderId,
    name: site.founder.name,
    jobTitle: site.founder.jobTitle[lang],
    worksFor: { '@id': businessId },
  },
  {
    '@type': 'WebSite',
    '@id': `${site.url}/#website`,
    url: `${site.url}/`,
    name: site.name,
    inLanguage: ['fr-CA', 'en-CA'],
    publisher: { '@id': businessId },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: pages.home[lang].crumb, item: abs(routes.home[lang]) },
      ...(page === 'home' ? [] : [{ '@type': 'ListItem', position: 2, name: text.crumb, item: pageUrl }]),
    ],
  },
];

const type = serviceType[page];
if (type) {
  graph.push({
    '@type': 'Service',
    '@id': `${pageUrl}#service`,
    name: type[lang],
    serviceType: type[lang],
    description: text.intro,
    provider: { '@id': businessId },
    areaServed,
    url: pageUrl,
  });

  const images = await Promise.all(
    photos.map(async (p) => {
      const img = await getImage({ src: p.src, width: Math.min(1600, p.src.width), format: 'jpg' });
      return {
        '@type': 'ImageObject',
        contentUrl: abs(img.src),
        width: img.attributes.width,
        height: img.attributes.height,
        caption: lang === 'fr' ? p.caption_fr : p.caption_en,
        ...(p.location && { contentLocation: { '@type': 'Place', name: p.location } }),
        creator: { '@id': founderId },
        copyrightHolder: { '@id': businessId },
        copyrightNotice: copyright,
        creditText: site.name,
      };
    }),
  );
  graph.push({
    '@type': 'ImageGallery',
    '@id': `${pageUrl}#gallery`,
    name: text.h1,
    url: pageUrl,
    inLanguage: htmlLang[lang],
    about: { '@id': `${pageUrl}#service` },
    image: images,
  });
}

const json = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---

<script type="application/ld+json" set:html={json} />
