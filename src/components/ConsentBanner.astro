---
import { routes, type Lang } from '../i18n/routes';
import { ui } from '../i18n/strings';
import { href } from '../i18n/url';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].consent;
---

<section id="consent" class="consent" aria-label={lang === 'fr' ? 'Témoins' : 'Cookies'} hidden>
  <p>{t.text} <a href={href(routes.privacy[lang])}>{t.more}</a></p>
  <div class="consent-actions">
    <button type="button" data-consent="denied">{t.reject}</button>
    <button type="button" data-consent="granted">{t.accept}</button>
  </div>
</section>

<script>
  import '../scripts/analytics';
</script>
